PORT=4000
INSTITUTE_NAME=Your Institute Name
# WhatsApp Cloud API (Meta). Leave DRY_RUN=true until templates are approved.
DRY_RUN=true
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_TEMPLATE_REMINDER=fee_reminder
WA_TEMPLATE_CONFIRM=fee_confirmation
WA_LANG=en
# Daily reminder time (cron) and timezone
REMINDER_CRON=0 9 * * *
TZ=Asia/Karachi
# Approved WhatsApp Utility template with one body parameter ({{1}}) for rent/installment notices
WA_TEMPLATE_REALESTATE=realestate_notice

# Daily automation schedules (Pakistan time)
REALESTATE_CRON=15 9 * * *
HOSPITAL_ALERT_CRON=30 9 * * *
